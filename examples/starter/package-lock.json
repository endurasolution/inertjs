{
  "name": "starter",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "starter",
      "dependencies": {
        "inertjs-cli": "file:../../packages/cli",
        "inertjs-shield": "file:../../packages/shield",
        "inertjs-vault": "file:../../packages/vault",
        "inertjs-vector": "file:../../packages/vector"
      }
    },
    "../../packages/cli": {
      "name": "inert",
      "version": "0.0.0",
      "bin": {
        "inert": "bin/inert.js"
      },
      "engines": {
        "node": ">=22.0.0"
      }
    },
    "../../packages/shield": {
      "name": "inertjs-shield",
      "version": "0.0.0",
      "engines": {
        "node": ">=22.0.0"
      }
    },
    "../../packages/vault": {
      "name": "inertjs-vault",
      "version": "0.0.0",
      "engines": {
        "node": ">=22.0.0"
      }
    },
    "../../packages/vector": {
      "name": "inertjs-vector",
      "version": "0.0.0",
      "dependencies": {
        "inertjs-optimizer": "file:../optimizer"
      },
      "engines": {
        "node": ">=22.0.0"
      }
    },
    "node_modules/inertjs-cli": {
      "resolved": "../../packages/cli",
      "link": true
    },
    "node_modules/inertjs-shield": {
      "resolved": "../../packages/shield",
      "link": true
    },
    "node_modules/inertjs-vault": {
      "resolved": "../../packages/vault",
      "link": true
    },
    "node_modules/inertjs-vector": {
      "resolved": "../../packages/vector",
      "link": true
    }
  }
}
